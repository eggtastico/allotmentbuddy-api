# allotment-api configuration — copy to .env and fill in. NEVER commit the real .env.
# (.env is gitignored; this .example documents the required/optional vars.)

# --- Supabase (auth + data) ---
SUPABASE_URL=https://your-supabase-host
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# --- OpenRouter (AI chat / vision — what the running server actually uses) ---
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=your-chat-model-slug
OPENROUTER_VISION_MODEL=your-vision-model-slug

# --- Google Gemini (OPTIONAL) ---
# Only needed if you re-enable direct @google/generative-ai calls.
# Get a key at https://aistudio.google.com/app/apikey and put it here — never inline in source.
GOOGLE_API_KEY=your-google-ai-studio-key
