# allotment-api configuration — copy to .env and fill in. NEVER commit the real .env.
# (.env is gitignored; this .example documents the required/optional vars.)

# --- Supabase (auth + data) ---
SUPABASE_URL=https://your-supabase-host
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# --- OpenRouter (AI chat / vision — what the running server actually uses) ---
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat, grow guide and watering: comma-separated, tried in order. All :free
# models share one daily request cap per key (50/day on a free-tier key).
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free,apodex/apodex-1.1-mini:free,google/gemma-4-31b-it:free
# Vision (seed-pack scan): comma-separated, tried in order — free models get
# rate-limited or withdrawn, so list fallbacks. Must accept image input.
OPENROUTER_VISION_MODEL=dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free

# --- Google Gemini (OPTIONAL) ---
# Only needed if you re-enable direct @google/generative-ai calls.
# Get a key at https://aistudio.google.com/app/apikey and put it here — never inline in source.
GOOGLE_API_KEY=your-google-ai-studio-key
